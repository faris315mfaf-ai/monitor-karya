# Variasi arsitektur Biznet — KVM 8 Hostinger (aplikasi) + Biznet (database
# terkelola + object storage S3 untuk bukti). Salin ke
# /srv/apps/monitor-karya/.env.production lalu: chmod 600 .env.production
# JANGAN commit berkas aslinya. Rencana lengkap:
# docs/zcode/DEPLOY-RENCANA-VPS-BIZNET.md

# --- Basis data terkelola Biznet (isi dari panel Biznet Anda) ---
# Wajib TLS; batasi akses hanya ke IP publik VPS aplikasi (IP allowlist Biznet).
# connection_limit menyesuaikan paket koneksi Biznet (mulai dari 10-20).
DATABASE_URL="postgresql://PENGGUNA:GANTI@HOST-BIZNET:5432/monitor_karya?sslmode=require&connection_limit=20&pool_timeout=20"
DIRECT_URL="postgresql://PENGGUNA:GANTI@HOST-BIZNET:5432/monitor_karya?sslmode=require"

# --- Sesi: minimal 32 karakter acak ---
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=GANTI

# --- Cron: minimal 16 karakter acak (dipakai dari dalam kontainer saja) ---
CRON_SECRET=GANTI

# --- Asal yang sah untuk cek CSRF (domain produksi Anda) ---
APP_ORIGINS=https://monitor.contoh.id

# --- Bukti: driver S3 ke object storage Biznet (S3-compatible) ---
# S3_ENDPOINT harus origin murni (tanpa path/query/kredensial).
# S3_FORCE_PATH_STYLE=true bila endpoint Biznet memakai path-style (umum).
STORAGE_DRIVER=s3
S3_ENDPOINT=https://GANTI-object-storage.biznetgio.com
S3_REGION=jakarta
S3_BUCKET=evidence
S3_ACCESS_KEY_ID=GANTI
S3_SECRET_ACCESS_KEY=GANTI
S3_FORCE_PATH_STYLE=true

# --- Status operasional privat; rahasia acak berbeda, masing-masing >=32 ---
OPS_HEALTH_SECRET=GANTI
BACKUP_REPORT_SECRET=GANTI
# Buat objek evidence/_health/readiness.txt berisi tepat monitor-karya-storage-v1
# tanpa newline (lihat docs/codex/CX20-OPERASIONAL.md).

# CATATAN: NEXT_PUBLIC_SUPABASE_URL TIDAK diperlukan pada arsitektur ini —
# CSP gambar/koneksi otomatis mengikuti origin S3_ENDPOINT. Jangan mengisi
# variabel Supabase bila Supabase tidak dipakai.
