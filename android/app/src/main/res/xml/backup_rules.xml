<?xml version="1.0" encoding="utf-8"?>
<!-- C3-S3 (API < 31): pengaman berlapis bersama allowBackup="false" — bila
     backup suatu saat dinyalakan, tidak ada data sesi/Room/berkas yang ikut. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
