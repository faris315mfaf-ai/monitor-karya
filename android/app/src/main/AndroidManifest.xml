<?xml version="1.0" encoding="utf-8"?>
<!-- Kelas .MKApp dan .MainActivity ditulis pada tugas A8; referensi dipasang lebih dulu.
     allowBackup=false: cookie sesi tidak boleh ikut backup (Rancangan §8). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Dideklarasikan eksplisit: sebelumnya INTERNET hanya "menumpang" dari manifes
         OkHttp (transitif) dan ACCESS_NETWORK_STATE dari WorkManager. Aplikasi ini
         tidak berguna tanpa keduanya (ConnectivityObserver + semua panggilan API). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- C3-S3: allowBackup=false hanya mematikan backup awan; sejak Android 12
         transfer antarperangkat diatur dataExtractionRules (semua domain
         dikecualikan). fullBackupContent = aturan setara untuk API < 31. -->
    <application
        android:name=".MKApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:theme="@style/Theme.MonitorKarya"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MonitorKarya"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager diinisialisasi MKApp (Configuration.Provider + HiltWorkerFactory);
             penginisialisasi bawaan androidx.startup dibuang supaya SyncWorker (@HiltWorker)
             dibangun lewat pabrik Hilt. Penginisialisasi startup lain tetap jalan. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
