# ============================================================
# MonitorKarya — konfigurasi lingkungan (Supabase)
# Salin file ini menjadi `.env` lalu isi nilainya.
# Nilai [YOUR-PASSWORD] (password database) ada di:
#   Supabase Dashboard -> Project Settings -> Database -> Connection string
# ============================================================

# Koneksi aplikasi (Prisma Client) lewat Supavisor transaction pooler, port 6543.
DATABASE_URL="postgresql://postgres.kgqpwlehjnoebunzshga:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Koneksi langsung (dipakai Prisma Migrate / seed), port 5432.
DIRECT_URL="postgresql://postgres.kgqpwlehjnoebunzshga:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase client (untuk Auth / Storage / Realtime di masa depan).
NEXT_PUBLIC_SUPABASE_URL="https://kgqpwlehjnoebunzshga.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_2JCkAbQPHRoiBsnX4fsRTQ_m7oNBqrv"

# Kunci penandatangan cookie sesi. Wajib, minimal 32 karakter.
# Buat baru: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="ganti-dengan-hasil-perintah-di-atas"

# Kata sandi awal akun hasil seed dan akun baru yang dibuat Super Admin
# (dipakai scripts/set-passwords.ts). Tidak pernah ditampilkan di halaman masuk.
SEED_PASSWORD="1234"

# Jam kunci (WIB, 0-23). Default 17 bila tidak diisi.
DAILY_CUTOFF_HOUR="17"
WEEKLY_CUTOFF_HOUR="17"

# Kunci service_role Supabase — WAJIB untuk unggah berkas bukti.
# Ambil di: Project Settings -> API Keys -> service_role (rahasia, jangan di-commit)
SUPABASE_SERVICE_ROLE_KEY="isi-dengan-service-role-key"

# Hari serah terima & kunci mingguan (ISO: 1=Senin .. 7=Minggu). Default 4 dan 5.
WEEKLY_HANDOVER_DAY="4"
WEEKLY_LOCK_DAY="5"


# Rahasia cron Vercel (pengingat otomatis ke divisi yang belum melapor).
# Vercel mengirim header "Authorization: Bearer <CRON_SECRET>" bila variabel ini
# ada di proyek. Buat: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=""
