# LOCAL_DB_PORT bawaan 54329; untuk alternatif 54339 berikan lewat shell.
# Salin ke .env.lokal. Jangan gunakan URL Supabase di sini.
DATABASE_URL="postgresql://mk_local:mk_local_dev_only@127.0.0.1:54329/monitor_karya_local?schema=public"
DIRECT_URL="postgresql://mk_local:mk_local_dev_only@127.0.0.1:54329/monitor_karya_local?schema=public"
# Gunakan openssl rand -hex 32 untuk nilai ini.
AUTH_SECRET="ganti-dengan-rahasia-acak-minimal-32-karakter"
SEED_PASSWORD="kata-sandi-lokal-aman"
STORAGE_DRIVER="supabase"
